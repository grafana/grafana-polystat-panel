/*
 * The scaffolded config only covers src/, so Playwright specs are never typechecked. A spec that
 * reads a property the shared helper no longer exports fails at runtime instead of at build time.
 */
{
  "extends": "./.config/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "noUnusedLocals": false,
    "paths": {
      "*": ["./src/*"]
    }
  },
  "include": ["tests", "playwright.config.ts"]
}
